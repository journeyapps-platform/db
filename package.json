{
  "name": "@ja-platform/db",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "version": "8.1.1",
  "description": "JourneyApps Platform database SDK",
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "typings": "./dist/@types/index.d.ts",
  "appTypings": "./dist/@types/app.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "ncu": "ncu -u",
    "test": "pnpm build && pnpm test:node",
    "watch": "tsc -b -w",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "ci:publish": "changeset publish && git push --follow-tags",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "test:node": "vitest --run --configLoader runner --config vitest.config.unit.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@journeyapps/domparser": "^0.4.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@types/node-fetch": "^2.6.13",
    "fetch-mock": "^12.6.0",
    "sqlite3": "^6.0.1",
    "websql": "^2.0.3",
    "jsdom": "24.0.0",
    "npm-check-updates": "^23.1.0"
  },
  "dependencies": {
    "@ja-platform/parser-schema": "0.0.0-dev-20261019214152",
    "@journeyapps/common-xml": "0.0.0-dev-20261019030214",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.18.1",
    "uuid": "^14.0.3",
    "xmldom": "^0.6.0",
    "@ja-platform/parser-expressions": "0.0.0-dev-20261019214152",
    "@ja-platform/parser-type-system": "0.0.0-dev-20261019214152"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@12.14.0"
}
